# FluxSave - Environment Variables

# Server
PORT=3000
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=https://your-domain.com

# Frontend
# The API base URL. Leave empty when the frontend is served by the same
# process as the API (the default in the Docker image).
# VITE_API_URL=https://api.your-domain.com
# VITE_API_TIMEOUT=30000

# Files larger than this (in MB) are downloaded directly from the source CDN
# instead of being streamed through the API. Set it to 0 to always download
# straight from the source, which keeps the server's bandwidth usage at zero.
# VITE_MAX_BUFFERED_MB=40

# Optional: Rate limiting configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
DOWNLOAD_RATE_LIMIT_MAX=10

# Optional: Secret used to sign media download tokens.
# Set this to the same value on every instance so tokens survive restarts
# and work across a load balanced deployment. Must be at least 16 characters.
# MEDIA_TOKEN_SECRET=change-me-to-a-long-random-string

# --- Extraction tools ---
# The backend shells out to Python helpers for platforms that need
# dedicated extractors. The tools are invoked with an argument array and
# never through a shell, so submitted URLs cannot be interpreted as commands.
#
#   pip install yt-dlp instaloader
#
# Override the interpreter if it is not on the PATH as "python" / "python3".
# PYTHON_BIN=python3

# Optional: path to the SERVER OPERATOR'S OWN session cookie file.
# Instagram refuses anonymous access for most posts, so the operator can
# provide their own cookie file to unlock it. Visitor cookies are never
# accepted or used.
# IG_COOKIE_FILE=/path/to/cookies.txt

# Optional: path to the SERVER OPERATOR'S OWN instaloader session file.
# instaloader stores a session when it is given a login; pointing this at that
# file lets the operator unlock their own content.
# IG_SESSION_FILE=/path/to/instaloader.session